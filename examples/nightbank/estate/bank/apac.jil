owner: ~{$OWNER}~
profile: ~{$NB_PROFILE}~
std_out_file: ~{$NB_LOGS}~/APAC_REC_CMD_TRADES_C.out
std_err_file: ~{$NB_LOGS}~/APAC_REC_CMD_TRADES_C.err
max_exit_success: 1

insert_job: APAC_REC_IRD_TRADES_C
job_type: c
box_name: APAC_REC_B
condition: s(APAC_REC_CUST_F) & s(APAC_EXE_IRD_TRADES_C)
command: fakework APAC_REC_IRD_TRADES_C --sleep 10 --consume incoming/apac_custody.csv --consume exe/apac/ird_trades.csv
machine: bank_core
owner: ~{$OWNER}~
profile: ~{$NB_PROFILE}~
std_out_file: ~{$NB_LOGS}~/APAC_REC_IRD_TRADES_C.out
std_err_file: ~{$NB_LOGS}~/APAC_REC_IRD_TRADES_C.err
max_exit_success: 1

insert_job: APAC_REC_CNV_TRADES_C
job_type: c
box_name: APAC_REC_B
condition: s(APAC_REC_CUST_F) & s(APAC_EXE_CNV_TRADES_C)
command: fakework APAC_REC_CNV_TRADES_C --sleep 15 --consume incoming/apac_custody.csv --consume exe/apac/cnv_trades.csv
machine: bank_core
owner: ~{$OWNER}~
profile: ~{$NB_PROFILE}~
std_out_file: ~{$NB_LOGS}~/APAC_REC_CNV_TRADES_C.out
std_err_file: ~{$NB_LOGS}~/APAC_REC_CNV_TRADES_C.err
max_exit_success: 1

insert_job: APAC_REC_POSN_C
job_type: c
box_name: APAC_REC_B
condition: s(APAC_REC_CUST_F)
command: fakework APAC_REC_POSN_C --sleep 9 --consume incoming/apac_custody.csv
machine: bank_core
owner: ~{$OWNER}~
profile: ~{$NB_PROFILE}~
std_out_file: ~{$NB_LOGS}~/APAC_REC_POSN_C.out
std_err_file: ~{$NB_LOGS}~/APAC_REC_POSN_C.err
resources: (GL_DB, QUANTITY=1)

insert_job: APAC_REC_GATE_C
job_type: c
box_name: APAC_REC_B
condition: s(APAC_REC_EQ_TRADES_C) & s(APAC_REC_GOV_TRADES_C) & s(APAC_REC_CRP_TRADES_C) & s(APAC_REC_MMK_TRADES_C) & s(APAC_REC_FXO_TRADES_C) & s(APAC_REC_CMD_TRADES_C) & s(APAC_REC_IRD_TRADES_C) & s(APAC_REC_CNV_TRADES_C) & s(APAC_REC_POSN_C)
command: dsl41 sendevent SET_GLOBAL --socket "$NIGHTBANK_SOCKET" --global RECON_APAC=CLEAN
machine: bank_core
owner: ~{$OWNER}~
profile: ~{$NB_PROFILE}~
std_out_file: ~{$NB_LOGS}~/APAC_REC_GATE_C.out
std_err_file: ~{$NB_LOGS}~/APAC_REC_GATE_C.err
