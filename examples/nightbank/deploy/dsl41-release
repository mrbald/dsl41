EXIT_OK = 0
EXIT_REFUSED = 2
EXIT_STOPPED = 3
EXIT_UNKNOWN = 4

#: the units' User= and the engine unit's name (dsl41-engine.service)
SERVICE_ACCOUNT = "dsl41"
ENGINE_UNIT = "dsl41-engine.service"
#: the actor every seal claims: the engine replaces a live claim with this spelling of the
#: service account it authenticates, and an offline seal records the claim (access-model ss3)
SEAL_ACTOR = f"os/{SERVICE_ACCOUNT}"
#: the path this file was run as, which the sudoers line names
INVOKED = Path(os.path.abspath(sys.argv[0]))
LAUNCH = Path(__file__).resolve().parent / "dsl41-launch"
#: one directory name under ESTATE_RELEASES, as the launcher reads ACTIVE (DL-407)
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}")
REQUEST_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
ACTOR = re.compile(r"[A-Za-z0-9._@/-]{1,200}")
SEGMENT = "[0-9]" * 6 + ".jsonl"
#: the seal's retry-horizon refusal (period-model ss9)
HORIZON = re.compile(
    r"was (-?\d+(?:\.\d+)?)s ago and the closing period's retry_horizon_us is (\d+)"
)
#: the job states the drain waits out (deployment-runbook ss0, job recipe step 3)
LIVE = ("STARTING", "RUNNING", "QUE_WAIT")
#: the apply's steps, in order; each is recorded before the next acts
STEPS = ("started", "held", "drained", "sealing", "sealed", "selected", "opened", "verified")
ABORTING = "aborting"
RESUME = {
    "started": "take the holds, drain, and seal under a new request id",
    "held": "take the holds, drain, and seal under a new request id",
    "drained": "take the holds, drain, and seal under a new request id",
    "sealing": "read the estate for request id {request_id}, go on if that seal committed,"
    " and otherwise send it again under that id, never a fresh one",
    "sealed": "write ACTIVE, start the engine unit, verify, and release the holds",
    "selected": "start the engine unit once the sealed engine has exited, verify, and"
    " release the holds",
    "opened": "verify the opened period and release the holds",
    "verified": "release the holds and write the receipt",
    ABORTING: "release the holds and clear the record; nothing was sealed",
}


class Stop(Exception):
    """The helper stops with an exit code from its header's table and one sentence."""

    def __init__(self, code: int, message: str) -> None:
        super().__init__(message)
        self.code = code


def say(message: str) -> None:
    print(f"dsl41-release: {message}", file=sys.stderr, flush=True)


def now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


# ------------------------------------------------------------ configuration


@dataclass(frozen=True)
class Config:
    """The launcher's CONFIGURATION as `dsl41-launch vars` prints it."""

    dsl41: str
    run_root: Path
    estate_anchor: Path
    releases: Path
    active: Path
    environment: str
    properties: str
    max_jobs: int
    max_grace_s: float
    next_profile: list[str]

    @property
    def socket(self) -> str:
        return str(self.run_root / "control.sock")

    @property
    def record(self) -> Path:
        return self.releases / ".apply.json"


def config() -> Config:
    done = subprocess.run([str(LAUNCH), "vars"], capture_output=True, text=True, check=False)
    if done.returncode != 0:
        raise Stop(EXIT_REFUSED, f"{LAUNCH} vars exited {done.returncode}: {done.stderr.strip()}")
    values: dict[str, str] = {}
    try:
        for line in done.stdout.splitlines():
            (word,) = shlex.split(line)
            key, _, value = word.partition("=")
            values[key] = value
        return Config(
            dsl41=values["DSL41"],
            run_root=Path(values["RUN_ROOT"]),
            estate_anchor=Path(values["ESTATE_ANCHOR"]),
            releases=Path(values["ESTATE_RELEASES"]),
            active=Path(values["ACTIVE"]),
            environment=values["ENVIRONMENT"],
            properties=values["PROPERTIES"],
            max_jobs=int(values["MAX_JOBS"]),
            max_grace_s=float(values["MAX_GRACE_S"]),
            next_profile=shlex.split(values["NEXT_PROFILE"]),
        )
    except (KeyError, ValueError) as exc:
        raise Stop(EXIT_REFUSED, f"{LAUNCH} vars printed no usable {exc}") from exc


def checked_name(name: str) -> str:
    if not NAME.fullmatch(name) or name.endswith(".new"):
        raise Stop(EXIT_REFUSED, f"'{name}' is not one release name")
    return name


def release_dir(cfg: Config, name: str) -> Path:
    path = cfg.releases / name
    if path.is_symlink():
        raise Stop(
            EXIT_REFUSED, f"{path} is a symlink: the opener must name the paths the seal named"
        )
    if not (path / "estate.toml").is_file():
        raise Stop(EXIT_REFUSED, f"{path} holds no estate.toml: not a release")
    return path


def read_active(cfg: Config) -> str:
    """ACTIVE's one line, refused as the launcher refuses it (DL-407)."""
    path = cfg.active
    if path.is_symlink() or not path.is_file():
        raise Stop(EXIT_REFUSED, f"{path} is not a plain file: no release is active")
    lines = path.read_text().splitlines()
    if len(lines) != 1 or not NAME.fullmatch(lines[0]):
        raise Stop(EXIT_REFUSED, f"{path} does not name one release")
    return lines[0]


def runtime_version() -> str:
    return importlib.metadata.version("dsl41")


def read_json(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text())
    except FileNotFoundError:
        return None
    if not isinstance(value, dict):
        raise Stop(EXIT_STOPPED, f"{path} is not a JSON object")
    return value


def write_json(path: Path, value: dict[str, Any]) -> None:
    """Write `value` beside `path` and rename it over, both durable."""
    write_text(path, json.dumps(value, indent=2, sort_keys=True) + "\n")


def write_text(path: Path, text: str) -> None:
    """Write `text` beside `path` and rename it over, both durable."""
    temp = path.with_name(f".{path.name}.{os.getpid()}")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    try:
        os.write(fd, text.encode())
        os.fchmod(fd, 0o644)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temp, path)
    fsync_dir(path.parent)


def fsync_dir(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def file_digests(path: Path) -> dict[str, str]:
    """The sha256 of every file of the release, its .release directory aside."""
    return {
        str(file.relative_to(path)): "sha256:" + hashlib.sha256(file.read_bytes()).hexdigest()
        for file in sorted(path.rglob("*"))
        if file.is_file() and ".release" not in file.relative_to(path).parts
    }


def changed_files(path: Path, prepared: dict[str, Any]) -> list[str]:
    recorded: dict[str, str] = prepared.get("files") or {}
    current = file_digests(path)
    return sorted(
        name for name in set(recorded) | set(current) if recorded.get(name) != current.get(name)
    )


def latest_receipt(cfg: Config, name: str) -> dict[str, Any] | None:
    """The receipt of the apply that last made NAME active, which .release/latest names."""
    directory = cfg.releases / name / ".release"
    try:
        latest = (directory / "latest").read_text().strip()
    except FileNotFoundError:
        return None
    return read_json(directory / latest)


# ------------------------------------------------ the service account's part


def as_service(*args: str) -> list[str]:
    return ["sudo", "-n", "-u", SERVICE_ACCOUNT, "-H", str(INVOKED), "service", *args]


def service_json(*args: str) -> dict[str, Any]:
    """One `service` read, as the service account; its stdout is one JSON object."""
    done = subprocess.run(as_service(*args), capture_output=True, text=True, check=False)
    sys.stderr.write(done.stderr)
    if done.returncode != 0:
        raise Stop(EXIT_STOPPED, f"the service account's {args[0]} exited {done.returncode}")
    try:
        answer: dict[str, Any] = json.loads(done.stdout)
    except ValueError as exc:
        raise Stop(EXIT_STOPPED, f"the service account's {args[0]} printed no JSON") from exc
    return answer


def estate_args(cfg: Config, path: Path, verb: str) -> list[str]:
    done = subprocess.run(
        [cfg.dsl41, "estate", "args", str(path / "estate.toml"), "--for", verb]
        + ["--environment", cfg.environment, "--format", "json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if done.returncode != 0:
        raise Stop(EXIT_REFUSED, f"estate args exited {done.returncode}: {done.stderr.strip()}")
    argv: list[str] = json.loads(done.stdout)["argv"]
    return argv


def service_check(cfg: Config, name: str) -> dict[str, Any]:
    """Lint and rehearse the release: what ran, its exit codes, its job count and the
    runtime's command grace."""
    from dsl41.period import CMD_GRACE_S

    path = cfg.releases / name
    lint = [cfg.dsl41, "lint", *estate_args(cfg, path, "lint"), "-p", cfg.properties]
    linted = subprocess.run(lint, capture_output=True, text=True, check=False)
    sys.stderr.write(linted.stdout + linted.stderr)
    rehearse = [cfg.dsl41, "rehearse", *estate_args(cfg, path, "rehearse")]
    rehearse += ["-p", cfg.properties, "--format", "json"]
    played = subprocess.run(rehearse, capture_output=True, text=True, check=False)
    sys.stderr.write(played.stderr)
    jobs = None
    if played.returncode == 0:
        jobs = len(json.loads(played.stdout)["jobs"])
    return {
        "lint": {"argv": lint, "exit": linted.returncode},
        "rehearse": {"argv": rehearse, "exit": played.returncode},
        "jobs": jobs,
        "grace_s": CMD_GRACE_S,
        "runtime": os.path.realpath(cfg.dsl41),
        "dsl41_version": runtime_version(),
    }


def service_changes(cfg: Config, before: str, after: str) -> dict[str, Any]:
    """The jobs release AFTER changes or removes against release BEFORE, by the classifier's
    leaf test, a fingerprint of each resolved definition (period-model ss10.2)."""
    from dsl41.cli_common import load_catalog_or_exit_2
    from dsl41.period import job_fingerprints

    prints = []
    for name in (before, after):
        argv = estate_args(cfg, release_dir(cfg, name), "viz")
        files = [Path(word) for word in argv if not word.startswith("-")]
        layers = [Path(argv[i + 1]) for i, word in enumerate(argv) if word == "-p"]
        files = [file for file in files if file not in layers]
        catalog = load_catalog_or_exit_2(files, False, [*layers, Path(cfg.properties)])
        prints.append(job_fingerprints(catalog))
    old, new = prints
    return {
        "changed": sorted(job for job in old if job in new and old[job] != new[job]),
        "removed": sorted(job for job in old if job not in new),
    }


def last_record(segment: Path) -> dict[str, Any] | None:
    """The last whole record of a WAL segment; a torn final append is no record."""
    with segment.open("rb") as stream:
        stream.seek(max(segment.stat().st_size - 65536, 0))
        lines = [line for line in stream.read().split(b"\n") if line]
    for line in reversed(lines[-2:]):
        try:
            record = json.loads(line)
        except ValueError:
            continue
        return record if isinstance(record, dict) else None
    return None


def committed(cfg: Config, request_id: str) -> dict[str, Any]:
    """Whether the seal REQUEST_ID committed, read as deployment-runbook ss6a Day 2 reads
    it: a `seal` record at the end of a WAL segment, the commit point, and its sidecar
    seals/<N>.json (period-model ss2.2). Never ACTIVE."""
    for segment in sorted((cfg.run_root / "wal").glob(SEGMENT))[-2:]:
        record = last_record(segment)
        if record is None or record.get("rec") != "seal":
            continue
        if record.get("request_id") != request_id:
            continue
        sidecar = cfg.run_root / "seals" / f"{segment.stem}.json"
        seal = json.loads(sidecar.read_text())
        nxt = seal["next_period"]
        return {
            "committed": True,
            "seal": str(sidecar),
            "period": int(record["period_id"]),
            "epoch": int(seal["epoch"]),
            "actor": record.get("claimed_actor"),
            "next_period": int(nxt["period_id"]),
            "next_baseline": nxt["baseline_id"],
            "source_bundle_hash": nxt["source_bundle_hash"],
        }
    return {"committed": False}


def service_pins(cfg: Config, request_id: str) -> dict[str, Any]:
    """What the opener wrote for the period the seal REQUEST_ID committed: the segment's
    opening record and leader records, the period's manifest, and the paths its bundle was
    read from."""
    seal = committed(cfg, request_id)
    if not seal["committed"]:
        raise Stop(EXIT_STOPPED, f"no committed seal in {cfg.run_root} names {request_id}")
    period = seal["next_period"]
    segment = cfg.run_root / "wal" / f"{period:06d}.jsonl"
    opening, epochs = None, []
    if segment.is_file():
        for line in segment.read_bytes().split(b"\n"):
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if record.get("rec") == "segment" and opening is None:
                opening = record
            if record.get("rec") == "leader":
                epochs.append(int(record["epoch"]))
    manifest = cfg.run_root / "periods" / f"{period:06d}" / "manifest.json"
    address = json.loads(manifest.read_text())["source_bundle_hash"]
    bundle = cfg.run_root / "catalogs" / str(address).split(":")[-1] / "sources.json"
    return seal | {
        "segment": opening,
        "leader_epoch": max(epochs, default=None),
        "manifest_source_bundle_hash": address,
        "sources": [entry["path"] for entry in json.loads(bundle.read_text())["sources"]],
    }


def hold_history(cfg: Config, job: str, request_id: str) -> dict[str, Any]:
    """Whether the run root's log holds the applied ON_HOLD of JOB under REQUEST_ID, and
    the request ids of applied OFF_HOLDs of JOB after it, across the last three WAL
    segments: an `input` names the verb, the job and the request id, and the `decision` at
    its index says whether it applied (period-model ss2.3)."""
    inputs: list[dict[str, Any]] = []
    applied: set[tuple[str, int]] = set()
    for segment in sorted((cfg.run_root / "wal").glob(SEGMENT))[-3:]:
        for line in segment.read_bytes().split(b"\n"):
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if record.get("rec") == "input" and (record.get("payload") or {}).get("job") == job:
                if record.get("kind") in ("ON_HOLD", "OFF_HOLD"):
                    inputs.append(record | {"segment": segment.name})
            if record.get("rec") == "decision" and record.get("decision") == "applied":
                applied.add((segment.name, int(record["index"])))
    found = False
    released_by: list[str] = []
    for record in inputs:
        if (record["segment"], int(record["seq"])) not in applied:
            continue
        if record["kind"] == "ON_HOLD" and record.get("request_id") == request_id:
            found, released_by = True, []
        elif found and record["kind"] == "OFF_HOLD":
            released_by.append(str(record.get("request_id")))
    return {"found": found, "released_by": released_by}


def service_seal(cfg: Config, name: str, request_id: str, actor: str) -> int:
    """The seal of the running period into release NAME, its profile restated from the
    launcher; dsl41's exit code is this command's. NAME must be prepared under this runtime
    with its files unchanged, so a hand-run seal is held to what prepare checked."""
    check_prepared(cfg, name)
    path = release_dir(cfg, name)
    argv = [cfg.dsl41, "seal", "--run-root", str(cfg.run_root)]
    argv += ["--estate-anchor", str(cfg.estate_anchor), *estate_args(cfg, path, "seal")]
    argv += ["-p", cfg.properties, *cfg.next_profile]
    argv += ["--claimed-actor", actor, "--request-id", request_id]
    print(f"dsl41-release: seal: {shlex.join(argv)}", file=sys.stderr, flush=True)
    return subprocess.run(argv, check=False).returncode


def service(argv: list[str]) -> int:
    cfg = config()
    action, rest = (argv[0], argv[1:]) if argv else ("", [])
    ids = [word for word in rest if REQUEST_ID.fullmatch(word)]
    if action == "check" and len(rest) == 1 and NAME.fullmatch(rest[0]):
        print(json.dumps(service_check(cfg, rest[0])))
        return EXIT_OK
    if action == "changes" and len(rest) == 2:
        print(json.dumps(service_changes(cfg, checked_name(rest[0]), checked_name(rest[1]))))
        return EXIT_OK
    if action == "seal" and len(rest) == 3 and ids == [rest[1]] and ACTOR.fullmatch(rest[2]):
        return service_seal(cfg, checked_name(rest[0]), rest[1], rest[2])
    if action == "committed" and len(rest) == 1 and ids == rest:
        print(json.dumps(committed(cfg, rest[0])))
        return EXIT_OK
    if action == "holds" and len(rest) == 2 and NAME.fullmatch(rest[0]) and ids == rest[1:]:
        print(json.dumps(hold_history(cfg, rest[0], rest[1])))
        return EXIT_OK
    if action == "pins" and len(rest) == 1 and ids == rest:
        print(json.dumps(service_pins(cfg, rest[0])))
        return EXIT_OK
    raise Stop(
        EXIT_REFUSED,
        "usage: service check NAME | changes FROM TO | seal NAME ID ACTOR | committed ID"
        f" | holds JOB ID | pins ID, not {argv}",
    )


# ------------------------------------------------------------------ prepare


def make_read_only(path: Path) -> None:
    """The release's inputs, readable by all and writable by none; its .release directory
    stays the helper's (DL-407)."""
    for directory, _, files in os.walk(path, topdown=False):
        here = Path(directory)
        for file in files:
            (here / file).chmod(0o444)
        here.chmod(0o755 if here.name == ".release" else 0o555)


def remove(path: Path) -> None:
    """A refused release, read-only directories included."""
    for directory, _, _ in os.walk(path):
        Path(directory).chmod(0o755)
    shutil.rmtree(path)


def qualify(cfg: Config, name: str) -> dict[str, Any]:
    """Lint and rehearse release NAME as the service account, and hold it to the
    launcher's ceiling; the check's record, or a refusal."""
    try:
        check = service_json("check", name)
    except Stop as exc:
        raise Stop(EXIT_REFUSED, str(exc)) from exc
    refusals = []
    if check["lint"]["exit"] != 0:
        refusals.append(f"lint exited {check['lint']['exit']}")
    if check["rehearse"]["exit"] != 0:
        refusals.append(f"rehearse exited {check['rehearse']['exit']}")
    elif check["jobs"] > cfg.max_jobs:
        refusals.append(f"it holds {check['jobs']} jobs, above MAX_JOBS={cfg.max_jobs}")
    if check["grace_s"] > cfg.max_grace_s:
        refusals.append(
            f"the runtime's command grace {check['grace_s']}s is above"
            f" MAX_GRACE_S={cfg.max_grace_s:g}"
        )
    if refusals:
        raise Stop(EXIT_REFUSED, f"{name} is refused: {'; '.join(refusals)}")
    return check


def write_prepared(cfg: Config, name: str, source: str | None, check: dict[str, Any]) -> None:
    path = cfg.releases / name
    write_json(
        path / ".release" / "prepared.json",
        {
            "name": name,
            "source": source,
            "prepared_at": now(),
            "prepared_by": getpass.getuser(),
            "environment": cfg.environment,
            "max_jobs": cfg.max_jobs,
            "max_grace_s": cfg.max_grace_s,
            "files": file_digests(path),
            **check,
        },
    )
    say(f"prepared {path}: {check['jobs']} jobs, under dsl41 {check['dsl41_version']}")


def prepare(name: str, source: Path) -> int:
    cfg = config()
    checked_name(name)
    target, staging = cfg.releases / name, cfg.releases / f"{name}.new"
    for path in (target, staging):
        if path.exists() or path.is_symlink():
            raise Stop(EXIT_REFUSED, f"{path} exists: a release is installed once")
    if not (source / "estate.toml").is_file():
        raise Stop(EXIT_REFUSED, f"{source} holds no estate.toml: not a release")
    if (source / ".release").exists():
        raise Stop(EXIT_REFUSED, f"{source} holds .release: copy a release's inputs, not it")
    shutil.copytree(source, staging)
    staging.rename(target)
    fsync_dir(cfg.releases)
    try:
        (target / ".release").mkdir()
        make_read_only(target)
        check = qualify(cfg, name)
    except BaseException:
        remove(target)
        raise
    write_prepared(cfg, name, str(source.resolve()), check)
    return EXIT_OK


def requalify(name: str) -> int:
    """The checks again, on the installed release under this runtime; its files must be
    the ones prepare checked, and prepared.json is replaced only when the checks pass."""
    cfg = config()
    path = release_dir(cfg, checked_name(name))
    earlier = read_json(path / ".release" / "prepared.json")
    if earlier is None:
        raise Stop(EXIT_REFUSED, f"{name} was never prepared: prepare its inputs under a new name")
    moved = changed_files(path, earlier)
    if moved:
        raise Stop(EXIT_REFUSED, f"{name}'s files changed since prepare: {', '.join(moved)}")
    write_prepared(cfg, name, earlier.get("source"), qualify(cfg, name))
    return EXIT_OK


def check_prepared(cfg: Config, name: str) -> None:
    """NAME is prepared under this runtime, and its files are the ones prepare checked."""
    path = release_dir(cfg, checked_name(name))
    prepared = read_json(path / ".release" / "prepared.json")
    if prepared is None:
        raise Stop(EXIT_REFUSED, f"{name} is not prepared: run `dsl41-release prepare` first")
    if prepared.get("dsl41_version") != runtime_version():
        raise Stop(
            EXIT_REFUSED,
            f"{name} was prepared under dsl41 {prepared.get('dsl41_version')}, and this"
            f" runtime is dsl41 {runtime_version()}: run `dsl41-release prepare --requalify"
            f" {name}`",
        )
    moved = changed_files(path, prepared)
    if moved:
        raise Stop(EXIT_REFUSED, f"{name}'s files changed since prepare: {', '.join(moved)}")


# -------------------------------------------------------------------- apply


@contextmanager
def apply_lock(cfg: Config) -> Iterator[None]:
    """ESTATE_RELEASES/.apply.lock, held for the whole apply; a held lock refuses."""
    path = cfg.releases / ".apply.lock"
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            holder = os.pread(fd, 4096, 0).decode(errors="replace").strip() or "unknown"
            raise Stop(EXIT_REFUSED, f"another apply holds {path}: {holder}") from None
        os.ftruncate(fd, 0)
        holder = f"pid {os.getpid()}, {getpass.getuser()}@{socket.gethostname()}, since {now()}"
        os.pwrite(fd, f"{holder}\n".encode(), 0)
        yield
    finally:
        os.close(fd)


def query(cfg: Config, what: str, job: str | None = None) -> dict[str, Any]:
    done = subprocess.run(
        [cfg.dsl41, "query", what, "-S", cfg.socket, *(["--job", job] if job else [])],
        capture_output=True,
        text=True,
    )
    if done.returncode != 0:
        raise Stop(EXIT_REFUSED, f"query {what} exited {done.returncode}: {done.stderr.strip()}")
    try:
        answer: dict[str, Any] = json.loads(done.stdout)
    except ValueError as exc:
        raise Stop(EXIT_REFUSED, f"query {what} printed no JSON: {exc}") from exc
    return answer


def send(cfg: Config, verb: str, job: str, *expect: str) -> tuple[int, dict[str, Any]]:
    """One sendevent; its exit code and its answer, a refusal's text under `error`."""
    done = subprocess.run(
        [cfg.dsl41, "sendevent", verb, "-J", job, "-S", cfg.socket, *expect],
        capture_output=True,
        text=True,
    )
    try:
        answer = json.loads(done.stdout.strip().splitlines()[-1]) if done.stdout.strip() else {}
    except ValueError:
        answer = {}
    if done.returncode not in (0, 2, 3, 4):
        raise Stop(
            EXIT_REFUSED, f"sendevent {verb} -J {job} exited {done.returncode}: {done.stderr}"
        )
    answer = answer if isinstance(answer, dict) else {}
    if done.returncode == 2:
        answer = answer | {"error": answer.get("error") or done.stderr.strip()}
    return done.returncode, answer


class Apply:
    """One apply, driven from its record, which is written before each step acts."""

    def __init__(self, cfg: Config, record: dict[str, Any], args: argparse.Namespace) -> None:
        self.cfg, self.record, self.args = cfg, record, args

    @property
    def name(self) -> str:
        return str(self.record["candidate"])

    def step(self, step: str) -> None:
        self.record["step"] = step
        self.record["updated_at"] = now()
        write_json(self.cfg.record, self.record)

    def at_or_before(self, step: str) -> bool:
        return STEPS.index(self.record["step"]) <= STEPS.index(step)

    def stopped(self, exc: BaseException) -> Stop:
        return Stop(
            EXIT_STOPPED,
            f"{exc}. The apply of {self.name} is recorded at step {self.record['step']};"
            f" `dsl41-release apply --resume {self.name}` will"
            f" {RESUME[self.record['step']].format(**self.record)}",
        )

    def run(self) -> int:
        if self.record["step"] == ABORTING:
            return self.abort("a refused apply's holds are released")
        if self.at_or_before("drained"):
            try:
                self.hold()
                self.step("held")
                self.drain()
                self.step("drained")
            except Stop as exc:
                if exc.code == EXIT_STOPPED:
                    raise self.stopped(exc) from exc
                return self.abort(str(exc))
        if self.at_or_before("sealing"):
            try:
                code = self.seal()
            except (Stop, OSError, ValueError, KeyError) as exc:
                raise self.stopped(exc) from exc
            if code == EXIT_REFUSED:
                return self.abort("the seal did not commit")
            if code != EXIT_OK:
                raise Stop(
                    EXIT_UNKNOWN,
                    f"the seal exited {code} and the estate shows no seal under request id"
                    f" {self.record['request_id']}: its outcome is unknown. `dsl41-release"
                    f" apply --resume {self.name}` reads the estate again and retries under"
                    " that id (deployment-runbook ss6a, Day 2)",
                )
            self.step("sealed")
            if os.environ.get("DSL41_RELEASE_STOP_AFTER") == "seal":
                os.kill(os.getpid(), signal.SIGKILL)
        try:
            if self.at_or_before("sealed"):
                self.select()
                self.step("selected")
            if self.at_or_before("selected"):
                self.start()
                self.step("opened")
            if self.at_or_before("opened"):
                self.verify()
                self.step("verified")
            released, kept = self.release_holds()
        except (Stop, OSError, ValueError, KeyError) as exc:
            raise self.stopped(exc) from exc
        seal = self.record["sealed"]
        receipt = {
            key: self.record.get(key)
            for key in ("previous", "request_id", "actor", "seal_actor", "holds", "started_at")
        }
        receipt |= {
            "name": self.name,
            "applied_at": now(),
            "period": seal["next_period"],
            "seal": seal["seal"],
            "source_bundle_hash": seal["source_bundle_hash"],
            "released": released,
            "kept": kept,
        }
        directory = self.cfg.releases / self.name / ".release"
        receipt_name = f"applied-{self.record['request_id']}.json"
        write_json(directory / receipt_name, receipt)
        write_text(directory / "latest", f"{receipt_name}\n")
        self.cfg.record.unlink()
        fsync_dir(self.cfg.releases)
        say(f"{self.name} is active in period {seal['next_period']}")
        return EXIT_OK

    def hold(self) -> None:
        """Hold every scheduled top-level job with a future tick that is not held; a hold
        that was there before stays and is never released here (deployment-runbook ss6).
        A hold is the helper's when its own request applied: the request id is composed and
        recorded before the send, so a resume sends a pending hold again under it."""
        for entry in self.record["holds"]:
            if entry["state"] == "pending":
                self.send_hold(entry)
        timers = query(self.cfg, "timers")["timers"]
        mine = {entry["job"] for entry in self.record["holds"] if entry["state"] != "rejected"}
        scheduled = sorted({row["job"] for row in timers if row.get("kind") == "schedule"})
        for job in (job for job in scheduled if job not in mine):
            for _ in range(3):
                answer = query(self.cfg, "status", job)
                row = answer["jobs"].get(job)
                if row is None or row.get("job_type") is None or row.get("box_name") is not None:
                    break
                if row.get("on_hold"):
                    break
                entry = {
                    "job": job,
                    "state": "pending",
                    "request_id": str(uuid.uuid4()),
                    "request_id_expect": int(row["state_rev"]),
                    "request_id_epoch": int(answer["epoch"]),
                    "request_id_baseline": str(answer["baseline_id"]),
                }
                self.record["holds"].append(entry)
                self.step(self.record["step"])
                if self.send_hold(entry):
                    break
            else:
                raise Stop(EXIT_REFUSED, f"{job} moved at each of three holds; apply again")
        taken = [entry["job"] for entry in self.record["holds"] if entry["state"] == "applied"]
        say(f"holds taken: {', '.join(taken) or 'none'}")

    def send_hold(self, entry: dict[str, Any]) -> bool:
        """The ON_HOLD of ENTRY under its recorded request id, expect, epoch and baseline; an
        exact resend is answered from the first decision, which settles whether the hold is
        the helper's. An applied answer that moved no revision of the job held nothing new (a
        RUNNING job's hold is a no-op), so that hold is never the helper's to release."""
        code, answer = self.send_recorded("ON_HOLD", entry, "request_id")
        if code == 2:
            entry |= {"state": "rejected", "reason": answer["error"]}
            self.step(self.record["step"])
            raise Stop(EXIT_REFUSED, f"the hold of {entry['job']} was refused: {answer['error']}")
        rev = (answer.get("revisions") or {}).get(f"job:{entry['job']}")
        if code != 0:
            entry["state"] = "rejected"
        elif rev is None:
            entry["state"] = "noop"
        else:
            entry |= {"state": "applied", "rev": rev}
        self.step(self.record["step"])
        return code == 0

    def send_recorded(self, verb: str, entry: dict[str, Any], key: str) -> tuple[int, Any]:
        """VERB for ENTRY's job under the request id at KEY and the expect, epoch and baseline
        recorded with it; no decision stops the apply with its record, and a resume sends
        the same request again."""
        code, answer = send(
            self.cfg,
            verb,
            entry["job"],
            *("--request-id", entry[key], "--expect", str(entry[f"{key}_expect"])),
            *("--epoch", str(entry[f"{key}_epoch"]), "--baseline", entry[f"{key}_baseline"]),
        )
        if code == 4:
            raise Stop(
                EXIT_STOPPED,
                f"the {verb} of {entry['job']} has no decision; a resume sends it again under"
                f" request id {entry[key]}",
            )
        return code, answer

    def drain(self) -> None:
        """No job STARTING, RUNNING or QUE_WAIT; then no job the release changes or removes
        may be armed or have a pending timer (deployment-runbook ss0, job recipe step 3)."""
        deadline = time.monotonic() + self.args.drain_timeout
        while True:
            jobs = query(self.cfg, "status")["jobs"]
            live = sorted(job for job, row in jobs.items() if row.get("status") in LIVE)
            if not live:
                break
            if time.monotonic() >= deadline:
                raise Stop(
                    EXIT_REFUSED,
                    f"still STARTING, RUNNING or QUE_WAIT after {self.args.drain_timeout:g}s:"
                    f" {', '.join(live)}",
                )
            time.sleep(1)
        changes = service_json("changes", self.record["previous"], self.name)

        def latent(job: str) -> bool:
            row = jobs.get(job) or {}
            return bool(row.get("armed") or row.get("pending_timers"))

        moving = [job for job in (*changes["removed"], *changes["changed"]) if latent(job)]
        if moving:
            raise Stop(
                EXIT_REFUSED,
                f"{', '.join(sorted(moving))}: a job the release changes or removes must not"
                " be live (armed, QUE_WAIT, a live timer); wait until it is not, or DISARM it",
            )

    def read_estate(self) -> bool:
        """Whether the seal under the recorded request id committed; records its facts."""
        seal = service_json("committed", self.record["request_id"])
        if seal["committed"]:
            self.record["sealed"] = seal
            say(f"the estate shows {seal['seal']} under request id {self.record['request_id']}")
        return bool(seal["committed"])

    def seal(self) -> int:
        """The seal, as the service account. A recorded request id is read in the estate
        before it is sent again, and so is every seal that did not exit 0. A retry-horizon
        refusal waits out the horizon it names and seals under a new request id (period-model
        ss9)."""
        if self.record.get("request_id") is not None and self.read_estate():
            return EXIT_OK
        deadline = time.monotonic() + self.args.horizon_timeout
        while True:
            if self.record.get("request_id") is None:
                self.record["request_id"] = str(uuid.uuid4())
            self.step("sealing")
            done = subprocess.run(
                as_service("seal", self.name, self.record["request_id"], self.record["seal_actor"]),
                capture_output=True,
                text=True,
            )
            sys.stderr.write(done.stdout + done.stderr)
            if done.returncode == EXIT_OK and os.environ.get("DSL41_RELEASE_STOP_AFTER") == (
                "seal-reply"
            ):
                os.kill(os.getpid(), signal.SIGKILL)
            if self.read_estate():
                return EXIT_OK
            if done.returncode == EXIT_OK:
                raise Stop(EXIT_STOPPED, "the seal exited 0 and the estate shows no seal")
            if done.returncode != EXIT_REFUSED:
                return done.returncode
            horizon = HORIZON.search(done.stdout + done.stderr)
            if horizon is None:
                return EXIT_REFUSED
            wait = int(horizon.group(2)) / 1e6 - float(horizon.group(1)) + 1.0
            if time.monotonic() + wait > deadline:
                say(f"the retry horizon outlasts --horizon-timeout {self.args.horizon_timeout:g}s")
                return EXIT_REFUSED
            say(f"waiting {wait:.1f}s for the retry horizon, then sealing again")
            time.sleep(max(wait, 0.0))
            self.record["request_id"] = None

    def select(self) -> None:
        """ACTIVE names the candidate: a plain file replaced by a rename (DL-407)."""
        write_text(self.cfg.active, f"{self.name}\n")

    def start(self) -> None:
        """Start the engine unit once the sealed engine has exited, and wait until the
        successor answers in the committed period under a new leader."""
        seal = self.record["sealed"]
        deadline = time.monotonic() + self.args.open_timeout
        if self.successor_answers():
            return
        show = ["systemctl", "show", "-p", "ActiveState", "--value", ENGINE_UNIT]
        while True:
            state = subprocess.run(show, capture_output=True, text=True).stdout.strip()
            if state in ("inactive", "failed"):
                break
            if time.monotonic() >= deadline:
                raise Stop(EXIT_STOPPED, f"{ENGINE_UNIT} is still {state}: the sealed engine")
            time.sleep(1)
        done = subprocess.run(["sudo", "-n", "systemctl", "start", ENGINE_UNIT], check=False)
        if done.returncode != 0:
            raise Stop(EXIT_STOPPED, f"systemctl start {ENGINE_UNIT} exited {done.returncode}")
        while time.monotonic() < deadline:
            if self.successor_answers():
                return
            time.sleep(1)
        raise Stop(
            EXIT_STOPPED,
            f"no engine answered in period {seal['next_period']} within"
            f" {self.args.open_timeout:g}s; read `journalctl -u {ENGINE_UNIT}`",
        )

    def successor_answers(self) -> bool:
        """An engine answers in the committed period's baseline, under an epoch past the
        seal's: the successor, not the sealed engine."""
        seal = self.record["sealed"]
        status = [self.cfg.dsl41, "query", "status", "-S", self.cfg.socket]
        done = subprocess.run(status, capture_output=True, text=True, check=False)
        if done.returncode != 0:
            return False
        header = json.loads(done.stdout)
        return bool(
            header.get("baseline_id") == seal["next_baseline"]
            and int(header.get("epoch", 0)) > int(seal["epoch"])
        )

    def verify(self) -> None:
        """The opener's segment, leader record and manifest name the bundle the seal
        committed, and the bundle was read from the candidate's files."""
        pins = service_json("pins", self.record["request_id"])
        prefix = f"{self.cfg.releases / self.name}/"
        sealed, period = pins["source_bundle_hash"], pins["next_period"]
        segment = pins["segment"] or {}
        problems = []
        if not segment:
            problems.append(f"period {period} has no opening segment")
        elif (
            segment.get("source_bundle_hash") != sealed
            or (segment.get("opens_from_seal") or {}).get("period_id") != pins["period"]
            or segment.get("baseline_id") != pins["next_baseline"]
        ):
            problems.append(f"period {period}'s segment does not open the committed seal")
        if pins["leader_epoch"] is None or pins["leader_epoch"] <= pins["epoch"]:
            problems.append(f"period {period} has no leader record after the seal")
        if pins["manifest_source_bundle_hash"] != sealed:
            problems.append(f"period {period}'s manifest pins another bundle than {sealed}")
        outside = [path for path in pins["sources"] if not path.startswith(prefix)]
        if outside:
            problems.append(f"the bundle reads {', '.join(outside)}, outside {prefix}")
        if problems:
            raise Stop(EXIT_STOPPED, "; ".join(problems))

    def release_holds(self) -> tuple[list[str], list[str]]:
        """OFF_HOLD for each hold this apply's own request applied, under a request id
        recorded before the send. A pending hold is settled first, and a release left without
        a decision is sent again under its id. A hold stays when the job is no longer held
        or no longer defined (a ghost keeps its row, period-model ss10), or when the run root's
        log shows an OFF_HOLD of the job from another request after the helper's hold: the
        hold there now is somebody else's. A hold the helper never applied is never released.
        The receipt's lists are the recorded states."""
        for entry in self.record["holds"]:
            if entry["state"] == "pending":
                self.send_hold(entry)
        for entry in self.record["holds"]:
            if entry["state"] == "applied":
                self.settle_release(entry)
            if entry["state"] == "releasing":
                self.send_release(entry)
        released = [e["job"] for e in self.record["holds"] if e["state"] == "released"]
        kept = [e["job"] for e in self.record["holds"] if e["state"] == "kept"]
        for entry in (e for e in self.record["holds"] if e["state"] == "kept"):
            say(f"hold of {entry['job']} kept: {entry['reason']}")
        return released, kept

    def settle_release(self, entry: dict[str, Any]) -> None:
        """Whether the helper's applied hold on ENTRY's job is still its own to release."""
        job = entry["job"]
        answer = query(self.cfg, "status", job)
        row = answer["jobs"].get(job)
        reason = None
        if row is None or row.get("job_type") is None:
            reason = "the job is no longer defined"
        elif not row.get("on_hold"):
            reason = "the job is no longer held"
        else:
            others = service_json("holds", job, entry["request_id"])
            if not others["found"]:
                reason = "the run root's log does not show the helper's hold"
            elif others["released_by"]:
                reason = f"released since by request {', '.join(others['released_by'])}"
        if reason is not None:
            entry |= {"state": "kept", "reason": reason}
        else:
            entry |= {
                "state": "releasing",
                "release_id": str(uuid.uuid4()),
                "release_id_expect": int(row["state_rev"]),
                "release_id_epoch": int(answer["epoch"]),
                "release_id_baseline": str(answer["baseline_id"]),
            }
        self.step(self.record["step"])

    def send_release(self, entry: dict[str, Any]) -> None:
        code, answer = self.send_recorded("OFF_HOLD", entry, "release_id")
        if code == 0:
            entry["state"] = "released"
        else:
            reason = answer.get("error") or answer.get("code") or answer.get("decision")
            entry |= {"state": "kept", "reason": f"OFF_HOLD exited {code}: {reason}"}
        self.step(self.record["step"])

    def abort(self, reason: str) -> int:
        """Nothing was sealed: release this apply's holds and clear its record."""
        self.step(ABORTING)
        try:
            self.release_holds()
        except Stop as exc:
            raise Stop(
                EXIT_STOPPED,
                f"{reason}, and releasing the holds failed: {exc}. `dsl41-release apply"
                f" --resume {self.name}` will {RESUME[ABORTING]}",
            ) from exc
        self.cfg.record.unlink()
        fsync_dir(self.cfg.releases)
        say(f"{self.name} is not applied: {reason}; ACTIVE still names {self.record['previous']}")
        return EXIT_REFUSED


def apply(args: argparse.Namespace, name: str | None) -> int:
    """An apply of NAME, or with no NAME the rollback to the active release's previous one;
    the target is resolved under the lock."""
    cfg = config()
    with apply_lock(cfg):
        record = read_json(cfg.record)
        if args.resume:
            if record is None:
                raise Stop(EXIT_REFUSED, f"no apply is recorded in {cfg.record}: nothing to resume")
            if record["candidate"] != name:
                raise Stop(
                    EXIT_REFUSED,
                    f"the recorded apply is of {record['candidate']}, not {name}",
                )
            if record["step"] in STEPS[: STEPS.index("sealing") + 1]:
                check_prepared(cfg, record["candidate"])
        else:
            if record is not None:
                raise Stop(
                    EXIT_REFUSED,
                    f"an apply of {record['candidate']} is recorded at step {record['step']}:"
                    " run `dsl41-release status`, then `dsl41-release apply --resume"
                    f" {record['candidate']}`",
                )
            previous = read_active(cfg)
            if name is None:
                latest = latest_receipt(cfg, previous)
                if latest is None or not latest.get("previous"):
                    raise Stop(EXIT_REFUSED, f"{previous}: no previous release; use apply NAME")
                name = str(latest["previous"])
                say(f"rolling back from {previous} to {name}")
            check_prepared(cfg, name)
            if previous == name:
                raise Stop(EXIT_REFUSED, f"{name} is already active")
            query(cfg, "status")
            record = {
                "candidate": name,
                "previous": previous,
                "step": STEPS[0],
                "request_id": None,
                "seal_actor": SEAL_ACTOR,
                "holds": [],
                "actor": f"{getpass.getuser()}@{socket.gethostname()}",
                "started_at": now(),
            }
            write_json(cfg.record, record)
        return Apply(cfg, record, args).run()


# ------------------------------------------------------------------- status


def status(fmt: str) -> int:
    cfg = config()
    try:
        active: str | None = read_active(cfg)
    except Stop:
        active = None
    releases: list[dict[str, Any]] = []
    for path in sorted(cfg.releases.iterdir()) if cfg.releases.is_dir() else []:
        if path.name.startswith(".") or not path.is_dir():
            continue
        receipts = sorted((path / ".release").glob("applied-*.json"))
        releases.append(
            {
                "name": path.name,
                "prepared": read_json(path / ".release" / "prepared.json"),
                "applied": latest_receipt(cfg, path.name),
                "applies": len(receipts),
            }
        )
    record = read_json(cfg.record)
    if record is not None:
        record["resume"] = RESUME[record["step"]].format(**record)
    report = {"active": active, "releases": releases, "apply": record}
    if fmt == "json":
        print(json.dumps(report, indent=2, sort_keys=True))
        return EXIT_OK
    print(f"active: {active or 'none'}")
    for release in releases:
        prepared, applied = release["prepared"], release["applied"]
        line = f"release {release['name']}: "
        line += (
            f"prepared {prepared['prepared_at']} under dsl41 {prepared['dsl41_version']}"
            if prepared
            else "not prepared"
        )
        if applied:
            line += (
                f"; applied {applied['applied_at']} after {applied['previous']},"
                f" period {applied['period']} ({release['applies']} applies)"
            )
        print(line)
    if record is None:
        print("apply: none recorded")
    else:
        print(
            f"apply: {record['candidate']} after {record['previous']}, at step"
            f" {record['step']}, request id {record['request_id']}"
        )
        print(f"  `dsl41-release apply --resume {record['candidate']}` will {record['resume']}")
    return EXIT_OK


# --------------------------------------------------------------------- main


def main(argv: list[str]) -> int:
    if argv[:1] == ["service"]:
        return service(argv[1:])
    parser = argparse.ArgumentParser(prog="dsl41-release")
    commands = parser.add_subparsers(dest="command", required=True)
    prep = commands.add_parser("prepare")
    prep.add_argument("--requalify", action="store_true")
    prep.add_argument("name")
    prep.add_argument("source", type=Path, nargs="?")
    for command in ("apply", "rollback"):
        sub = commands.add_parser(command)
        if command == "apply":
            sub.add_argument("--resume", action="store_true")
            sub.add_argument("name")
        sub.add_argument("--drain-timeout", type=float, default=600.0)
        sub.add_argument("--horizon-timeout", type=float, default=300.0)
        sub.add_argument("--open-timeout", type=float, default=90.0)
    report = commands.add_parser("status")
    report.add_argument("--format", choices=("text", "json"), default="text")
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return EXIT_REFUSED if exc.code else EXIT_OK
    if args.command == "prepare":
        if args.requalify != (args.source is None):
            parser.print_usage(sys.stderr)
            return EXIT_REFUSED
        return requalify(args.name) if args.requalify else prepare(args.name, args.source)
    if args.command == "apply":
        return apply(args, args.name)
    if args.command == "rollback":
        args.resume = False
        return apply(args, None)
    return status(args.format)


if __name__ == "__main__":
    os.umask(0o022)
    try:
        sys.exit(main(sys.argv[1:]))
    except Stop as stop:
        say(str(stop))
        sys.exit(stop.code)
    except Exception as exc:  # anything else stops here, with its record kept
        say(f"stopped: {exc!r}; `dsl41-release status` shows whether an apply is recorded")
        sys.exit(EXIT_STOPPED)
