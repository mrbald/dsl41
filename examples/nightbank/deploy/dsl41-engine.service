# dsl41-engine.service -- the nightbank example (DL-424). Every path and name
# here is synthetic; install as /etc/systemd/system/dsl41-engine.service.
#
# One unit: the engine and every job it launches live in this unit's cgroup.
# A stop is the engine's drain (spec-drain): ExecStop asks the engine to stop
# every running job, TERM then KILL after the grace, record how each ended,
# and exit 0; it returns once the engine has exited.
[Unit]
Description=dsl41 engine (nightbank example)
# the run root below; no start before its file system is mounted, so an
# absent mount is never read as an empty root
RequiresMountsFor=/srv/dsl41/runs/nightbank /opt/nightbank/cfg /etc/dsl41
# start after the clock is synchronised, so a boot-time step of the wall clock
# comes before the engine's first stamp (runner-design §4)
Wants=time-sync.target
After=time-sync.target
# at most five starts in five minutes, then the unit stays failed: bounds a
# crash that repeats
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=dsl41
Group=dsl41
# a run root that holds engine.db resumes the run it records, so a restart
# reruns this same line (DL-428); a missing root is created
ExecStart=/opt/dsl41/releases/<version>/bin/dsl41 run --config /etc/dsl41/dsl41.toml
# the drain: returns once the socket is gone and leader.lock is free
ExecStop=/opt/dsl41/releases/<version>/bin/dsl41 engine stop --wait \
    --socket /srv/dsl41/runs/nightbank/control.sock
# grace_term_s + grace_kill_s + 30 with engine.toml's defaults (10 + 5 + 30);
# the engine's own deadline ends the drain at grace_term_s + grace_kill_s + 5
TimeoutStopSec=45
# every exit restarts, the drain's 0 included: an engine stopped by
# `dsl41 engine stop` outside systemctl comes back on the same root. Exit 2
# (the run never started: a refusal), 6 (a time-half stop) and 7 (a
# statechart error) would meet the same fault again, so they stay down
Restart=always
RestartSec=5
RestartPreventExitStatus=2 6 7
# a job that escaped its process group is still in this cgroup: the stop
# ends it after ExecStop
KillMode=control-group
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
